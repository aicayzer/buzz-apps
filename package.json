{
  "name": "buzz-apps",
  "version": "0.1.0-rc.1",
  "private": false,
  "type": "module",
  "description": "Community apps for Buzz, starting with GitHub.",
  "license": "MIT",
  "bin": {
    "buzz-apps": "dist/src/cli/main.js"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.1",
    "fastify": "^5.12.4",
    "nostr-tools": "^2.25.2",
    "octokit": "^5.0.5",
    "picomatch": "^4.0.7",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/picomatch": "^4.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aicayzer/buzz-apps.git"
  }
}
